{
  "rules": {
    ".read": false,
    ".write": false,
    "scores": {
      ".read": true,
      ".indexOn": ["score"],
      "$entry": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['name', 'score', 'ts'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
        },
        "score": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50000"
        },
        "ts": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
